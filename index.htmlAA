<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>T926 · Calculadora de barrenos</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Saira+Condensed:wght@500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#F1F3EF;
  --card:#FFFFFF;
  --ink:#101B24;
  --muted:#6C7A84;
  --rule:#D6DCD8;
  --cad:#1B4FCF;
  --hole:#BE1265;
  --warn:#9C5406;
  --ok:#1F6B4A;
  --sans:"Saira Condensed","Arial Narrow",system-ui,sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,"SF Mono","Roboto Mono",monospace;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:var(--paper);
  color:var(--ink);
  font-family:var(--mono);
  font-size:14px;
  line-height:1.45;
  -webkit-font-smoothing:antialiased;
}
.wrap{max-width:1180px;margin:0 auto;padding:18px 16px 64px}

/* ---------- cabecera ---------- */
header{
  border:1.5px solid var(--ink);
  background:var(--card);
  display:flex;flex-wrap:wrap;align-items:stretch;
}
.plate{
  padding:12px 16px;border-right:1.5px solid var(--ink);
  display:flex;flex-direction:column;justify-content:center;
}
.plate .code{
  font-family:var(--sans);font-weight:700;font-size:34px;letter-spacing:.06em;
  line-height:1;text-transform:uppercase;
}
.plate .sub{font-size:11px;color:var(--muted);letter-spacing:.09em;text-transform:uppercase;margin-top:4px}
.title{padding:12px 16px;display:flex;flex-direction:column;justify-content:center;flex:1;min-width:220px}
.title h1{
  font-family:var(--sans);font-weight:600;font-size:22px;margin:0;letter-spacing:.02em;
  text-transform:uppercase;
}
.title p{margin:2px 0 0;font-size:12px;color:var(--muted)}
.stamp{
  border-left:1.5px solid var(--ink);padding:12px 16px;font-size:11px;color:var(--muted);
  display:flex;align-items:center;letter-spacing:.06em;text-transform:uppercase;
}

/* ---------- rejilla principal ---------- */
.grid{display:grid;grid-template-columns:290px 1fr;gap:16px;margin-top:16px;align-items:start}
@media (max-width:880px){.grid{grid-template-columns:1fr}}

.panel{background:var(--card);border:1.5px solid var(--ink)}
.panel > .head{
  font-family:var(--sans);font-weight:600;text-transform:uppercase;letter-spacing:.1em;
  font-size:12px;padding:7px 12px;border-bottom:1.5px solid var(--ink);
  display:flex;justify-content:space-between;align-items:center;
}
.panel > .body{padding:12px}

/* ---------- entradas ---------- */
.field{display:grid;grid-template-columns:1fr 96px;gap:8px;align-items:center;margin-bottom:9px}
.field label{font-size:12px;line-height:1.25}
.field label b{font-family:var(--sans);font-size:14px;letter-spacing:.04em;font-weight:600}
.field label span{display:block;color:var(--muted);font-size:10.5px;letter-spacing:.02em}
.field input,.field select{
  font-family:var(--mono);font-size:15px;font-weight:500;
  width:100%;padding:7px 8px;border:1.2px solid var(--rule);background:#FBFCFA;color:var(--ink);
  border-radius:0;
}
.field input:focus,.field select:focus{outline:2px solid var(--cad);outline-offset:1px;border-color:var(--cad)}
.field input.bad{border-color:var(--warn);background:#FDF6EC}
.seg{display:flex;border:1.2px solid var(--rule);margin:2px 0 12px}
.seg button{
  flex:1;font-family:var(--sans);font-size:12px;letter-spacing:.06em;text-transform:uppercase;
  padding:7px 4px;background:#FBFCFA;border:0;cursor:pointer;color:var(--muted);font-weight:600;
}
.seg button[aria-pressed="true"]{background:var(--ink);color:#fff}
.seg button:focus-visible{outline:2px solid var(--cad);outline-offset:-2px}
.hint{font-size:11px;color:var(--muted);border-top:1px dashed var(--rule);padding-top:9px;margin-top:4px}

/* ---------- avisos ---------- */
#avisos{margin-top:10px;display:flex;flex-direction:column;gap:6px}
.aviso{
  font-size:11.5px;padding:7px 9px;border-left:4px solid var(--warn);
  background:#FBF3E6;color:var(--warn);
}
.aviso.info{border-left-color:var(--cad);background:#EDF2FD;color:#173F9E}

/* ---------- dibujos ---------- */
.draws{display:grid;grid-template-columns:1fr 1fr;gap:0}
@media (max-width:620px){.draws{grid-template-columns:1fr}}
.draw{padding:10px 6px 14px;border-right:1.2px solid var(--rule)}
.draws .draw:last-child{border-right:0}
@media (max-width:620px){.draw{border-right:0;border-bottom:1.2px solid var(--rule)}}
.draw h3{
  font-family:var(--sans);font-size:13px;text-transform:uppercase;letter-spacing:.1em;
  margin:0 0 2px;text-align:center;font-weight:600;
}
.draw .spec{text-align:center;font-size:11px;color:var(--hole);letter-spacing:.04em;margin-bottom:6px}
svg{display:block;width:100%;height:auto}
.dim{stroke:var(--cad);stroke-width:.9;fill:none}
.dimtxt{font-family:var(--mono);font-size:10px;fill:var(--cad)}
.holetxt{font-family:var(--mono);font-size:10.5px;fill:var(--hole);font-weight:600}
.edge{stroke:var(--ink);stroke-width:1.6;fill:#E9E2D3}
.center{stroke:var(--hole);stroke-width:.9;stroke-dasharray:10 3 2 3}
.hole{fill:none;stroke:var(--hole);stroke-width:1.5}
.holedot{fill:var(--hole)}

/* ---------- tablas ---------- */
table{width:100%;border-collapse:collapse;font-size:12.5px}
th,td{border:1px solid var(--rule);padding:6px 8px;text-align:right}
th{
  font-family:var(--sans);font-weight:600;font-size:11px;letter-spacing:.07em;text-transform:uppercase;
  background:#F6F8F4;color:var(--muted);
}
td.l,th.l{text-align:left}
td.num{font-weight:600;font-variant-numeric:tabular-nums}
td.key{color:var(--hole);font-weight:600;font-size:14px;font-variant-numeric:tabular-nums}
tr.total td{background:#F6F8F4}

.duo{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}
@media (max-width:880px){.duo{grid-template-columns:1fr}}

/* tabla de holgura */
.clr{font-size:11px}
.clr th,.clr td{padding:4px 5px;text-align:center}
.clr td.on{background:var(--hole);color:#fff;font-weight:600}
.clr th.on{background:var(--ink);color:#fff}

.foot{margin-top:16px;font-size:11px;color:var(--muted);border-top:1.2px solid var(--rule);padding-top:10px}
.btn{
  font-family:var(--sans);text-transform:uppercase;letter-spacing:.08em;font-size:12px;font-weight:600;
  background:var(--ink);color:#fff;border:0;padding:8px 14px;cursor:pointer;
}
.btn:focus-visible{outline:2px solid var(--cad);outline-offset:2px}
.btn.ghost{background:transparent;color:var(--ink);border:1.2px solid var(--ink)}

@media print{
  body{background:#fff}
  .noprint{display:none!important}
  .wrap{max-width:none;padding:0}
  .grid{grid-template-columns:250px 1fr}
  .panel,header{border-color:#000}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body>
<div class="wrap">

<header>
  <div class="plate">
    <div class="code">T926</div>
    <div class="sub">Push to open · slide-in</div>
  </div>
  <div class="title">
    <h1>Calculadora de barrenos</h1>
    <p>Puerta y panel lateral · medidas en mm · según manual de instalación Tutti</p>
  </div>
  <div class="stamp" id="stamp">Rev. 1</div>
</header>

<div class="grid">

  <!-- ENTRADAS -->
  <section class="panel noprint-keep">
    <div class="head">Medidas del gabinete</div>
    <div class="body">
      <div class="field">
        <label><b>H</b> Alto del gabinete <span>1200 – 2800</span></label>
        <input id="H" type="number" value="2400" step="1" inputmode="decimal">
      </div>
      <div class="field">
        <label><b>S</b> Profundidad <span>400 – 700</span></label>
        <input id="S" type="number" value="600" step="1" inputmode="decimal">
      </div>
      <div class="field">
        <label><b>W</b> Ancho interior <span>luz del gabinete</span></label>
        <input id="W" type="number" value="900" step="1" inputmode="decimal">
      </div>
      <div class="field">
        <label><b>T</b> Espesor de la puerta <span>18 – 25</span></label>
        <input id="T" type="number" value="18" step="0.5" inputmode="decimal">
      </div>
      <div class="field">
        <label><b>C</b> Espesor del lateral <span>18 – 25</span></label>
        <input id="C" type="number" value="18" step="0.5" inputmode="decimal">
      </div>

      <div class="head" style="border:0;padding:12px 0 4px;font-size:11px">Ancho de puerta</div>
      <div class="seg" role="group" aria-label="Modo de ancho de puerta">
        <button id="mDoble" aria-pressed="true">Juego doble</button>
        <button id="mManual" aria-pressed="false">Manual</button>
      </div>
      <div class="field" id="dwManualRow" style="display:none">
        <label><b>DW</b> Ancho de puerta <span>medida real de la hoja</span></label>
        <input id="DWm" type="number" value="500" step="1" inputmode="decimal">
      </div>

      <div class="head" style="border:0;padding:12px 0 4px;font-size:11px">Mano</div>
      <div class="seg" role="group" aria-label="Mano de la pieza">
        <button id="lDer" aria-pressed="true">Derecha</button>
        <button id="lIzq" aria-pressed="false">Izquierda</button>
      </div>

      <div class="field">
        <label><b>K</b> Holgura de apertura <span>4 – 8</span></label>
        <select id="K">
          <option>4</option><option>5</option><option selected>6</option><option>7</option><option>8</option>
        </select>
      </div>

      <div id="avisos"></div>

      <div class="hint">
        El ancho de la puerta no cambia la posición de los barrenos: solo mueve el dibujo.
        Lo que manda es <b>H</b> para la puerta y para el lateral, y <b>T</b> para la distancia al canto del lateral.
      </div>
    </div>
  </section>

  <!-- DIBUJOS -->
  <section class="panel">
    <div class="head">
      <span>Vista de frente · barrenos a escala</span>
      <span style="color:var(--muted);font-weight:500" id="escala">1:20</span>
    </div>
    <div class="draws">
      <div class="draw">
        <h3>Puerta</h3>
        <div class="spec">&#8709;35 &times; 12 mm de profundidad</div>
        <div id="svgPuerta"></div>
      </div>
      <div class="draw">
        <h3>Panel lateral</h3>
        <div class="spec">&#8709;35 &times; 11.5 mm de profundidad</div>
        <div id="svgLateral"></div>
      </div>
    </div>
  </section>
</div>

<!-- RESULTADOS -->
<div class="duo">
  <section class="panel">
    <div class="head">Barrenos de la puerta · cazoleta &#8709;35</div>
    <div class="body">
      <table>
        <thead>
          <tr><th class="l">Barreno</th><th>Desde el tope</th><th>Al canto</th><th>Prof.</th></tr>
        </thead>
        <tbody id="tbPuerta"></tbody>
      </table>
      <p style="font-size:11px;color:var(--muted);margin:9px 0 0">
        Los dos del centro van simétricos al riel medio, 500 mm entre ellos.
        Alto de la puerta <b id="dhTxt">—</b> mm.
      </p>
    </div>
  </section>

  <section class="panel">
    <div class="head">Barrenos del panel lateral · rueda guía</div>
    <div class="body">
      <table>
        <thead>
          <tr><th class="l">Barreno</th><th>Desde el tope</th><th>Al canto frontal</th><th>Prof.</th></tr>
        </thead>
        <tbody id="tbLateral"></tbody>
      </table>
      <p style="font-size:11px;color:var(--muted);margin:9px 0 0">
        Los barrenos van hacia el frente. La distancia al canto <b>S3 = T + 20</b> depende del espesor de la puerta.
      </p>
    </div>
  </section>
</div>

<div class="duo">
  <section class="panel">
    <div class="head">Medidas derivadas</div>
    <div class="body">
      <table>
        <tbody id="tbParam"></tbody>
      </table>
    </div>
  </section>

  <section class="panel">
    <div class="head">Holgura de apertura · valor A</div>
    <div class="body">
      <div id="clrTabla"></div>
      <p style="font-size:11px;color:var(--muted);margin:9px 0 0">
        Valor A para el juego de apertura, cruzando K con el espesor de la puerta.
        Lectura activa: <b id="clrTxt">—</b>
      </p>
    </div>
  </section>
</div>

<div class="foot">
  <div class="noprint" style="display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap">
    <button class="btn" onclick="window.print()">Imprimir hoja de taladro</button>
    <button class="btn ghost" id="btnCopiar">Copiar medidas</button>
    <button class="btn ghost" id="btnDxfP">DXF puerta</button>
    <button class="btn ghost" id="btnDxfL">DXF lateral</button>
    <button class="btn ghost" id="btnCsv">CSV</button>
    <button class="btn ghost" id="btnJson">JSON</button>
    <span id="copyMsg" style="align-self:center;font-size:11px;color:var(--ok)"></span>
  </div>
  <p style="margin:0 0 10px">
    El DXF sale en milímetros, con el origen en la esquina inferior izquierda de la pieza vista por la cara
    que se taladra. Los barrenos son círculos de &#8709;35 en capas separadas por profundidad.
  </p>
  Datos tomados del manual de instalación T926 (Tutti). Rangos del sistema: H 1200–2800 · S 400–700 · T 18–25 · C 18–25.
  Verifica siempre el primer gabinete antes de correr producción.
</div>

</div>

<script>
(function(){
  const $ = id => document.getElementById(id);
  const inputs = ['H','S','W','T','C','DWm','K'].map($);
  let modoDoble = true;

  const CLR = {
    4:[0,0,0,0.1,0.2,0.3,0.3,0.4],
    5:[0,0,0,0,0.1,0.2,0.2,0.3],
    6:[0,0,0,0,0.1,0.2,0.2,0.3],
    7:[0,0,0,0,0.1,0.2,0.2,0.3],
    8:[0,0,0,0,0.1,0.2,0.2,0.3]
  };

  const fmt = n => {
    if (!isFinite(n)) return '—';
    return (Math.round(n*100)/100).toString();
  };

  function leer(){
    const v = k => parseFloat($(k).value);
    return {H:v('H'), S:v('S'), W:v('W'), T:v('T'), C:v('C'), DWm:v('DWm'), K:parseInt($('K').value,10)};
  }

  function avisar(d, DH){
    const box = $('avisos'); box.innerHTML = '';
    const add = (txt,cls) => {
      const el = document.createElement('div');
      el.className = 'aviso' + (cls ? ' '+cls : '');
      el.textContent = txt; box.appendChild(el);
    };
    const rango = (val,min,max,nom,id) => {
      const bad = !isFinite(val) || val < min || val > max;
      $(id).classList.toggle('bad', bad);
      if (!isFinite(val)) { add(nom + ': falta la medida.'); return; }
      if (bad) add(nom + ' fuera del rango del sistema (' + min + '–' + max + ').');
    };
    rango(d.H,1200,2800,'Alto H','H');
    rango(d.S,400,700,'Profundidad S','S');
    rango(d.T,18,25,'Espesor de puerta T','T');
    rango(d.C,18,25,'Espesor del lateral C','C');

    if (isFinite(DH)) {
      const sep = (DH/2 - 250) - 200;
      if (sep < 35) add('Los barrenos del centro quedan a menos de 35 mm de los de las puntas. Revisa el alto antes de taladrar.');
    }
    if (isFinite(d.W) && d.W > 0 && modoDoble) {
      add('Ancho de puerta calculado como juego doble: DW = W/2 + 50. Para hoja sencilla usa el modo manual.','info');
    }
  }

  // ---------- dibujo ----------
  function dibujar(cfg){
    const W = 300, Hs = 560;
    const boxT = 60, boxB = Hs - 40, boxH = boxB - boxT;
    const maxW = 90;
    const esc = Math.min(boxH / cfg.alto, maxW / Math.max(cfg.ancho, 1));
    const pw = cfg.ancho * esc, ph = cfg.alto * esc;
    const x0 = 74, x1 = x0 + pw;
    const y0 = boxT, y1 = y0 + ph;
    const der = cfg.lado !== 'izq';
    const ejeX = der ? (x1 - cfg.canto * esc) : (x0 + cfg.canto * esc);
    const cantoBorde = der ? x1 : x0;
    const rh = Math.max(2.6, (35/2) * esc);
    let s = '';

    s += '<rect class="edge" x="'+x0.toFixed(1)+'" y="'+y0.toFixed(1)+'" width="'+pw.toFixed(1)+'" height="'+ph.toFixed(1)+'"/>';

    // eje vertical de los barrenos
    s += '<line class="center" x1="'+ejeX.toFixed(1)+'" y1="'+(y0-18)+'" x2="'+ejeX.toFixed(1)+'" y2="'+(y1+12)+'"/>';

    // cota al canto
    const yc = y0 - 26;
    const fuera = der ? (cantoBorde + 16) : (cantoBorde - 16);
    s += '<line class="dim" x1="'+ejeX.toFixed(1)+'" y1="'+(yc-6)+'" x2="'+ejeX.toFixed(1)+'" y2="'+(yc+8)+'"/>';
    s += '<line class="dim" x1="'+cantoBorde.toFixed(1)+'" y1="'+(yc-6)+'" x2="'+cantoBorde.toFixed(1)+'" y2="'+(y0)+'"/>';
    s += '<line class="dim" x1="'+ejeX.toFixed(1)+'" y1="'+yc+'" x2="'+fuera+'" y2="'+yc+'" marker-start="url(#ar)" marker-end="url(#ar)"/>';
    s += '<text class="dimtxt" x="'+(der?(cantoBorde+22):(cantoBorde-22))+'" y="'+(yc+3.5)+'" text-anchor="'+(der?'start':'end')+'">'+cfg.cantoTxt+'</text>';

    // barrenos + acotado a la derecha
    const xd = der ? (x1 + 34) : (x0 - 34);
    cfg.holes.forEach(function(h){
      const y = y0 + h.pos * esc;
      s += '<circle class="hole" cx="'+ejeX.toFixed(1)+'" cy="'+y.toFixed(1)+'" r="'+rh.toFixed(1)+'"/>';
      s += '<circle class="holedot" cx="'+ejeX.toFixed(1)+'" cy="'+y.toFixed(1)+'" r="1.1"/>';
      s += '<line class="dim" x1="'+(der?(ejeX+rh+2):(ejeX-rh-2)).toFixed(1)+'" y1="'+y.toFixed(1)+'" x2="'+(der?(xd-4):(xd+4))+'" y2="'+y.toFixed(1)+'" stroke-dasharray="2 2"/>';
      s += '<text class="holetxt" x="'+xd+'" y="'+(y+3.5).toFixed(1)+'" text-anchor="'+(der?'start':'end')+'">'+fmt(h.pos)+'</text>';
    });

    // cota total, al lado contrario de los barrenos
    const xl = der ? (x0 - 30) : (x1 + 30);
    const xlRef = der ? x0 : x1;
    s += '<line class="dim" x1="'+xl+'" y1="'+y0+'" x2="'+xl+'" y2="'+y1+'" marker-start="url(#ar)" marker-end="url(#ar)"/>';
    s += '<line class="dim" x1="'+xl+'" y1="'+y0+'" x2="'+xlRef+'" y2="'+y0+'" stroke-dasharray="2 2"/>';
    s += '<line class="dim" x1="'+xl+'" y1="'+y1+'" x2="'+xlRef+'" y2="'+y1+'" stroke-dasharray="2 2"/>';
    s += '<text class="dimtxt" transform="translate('+(der?(xl-5):(xl+11))+','+((y0+y1)/2)+') rotate(-90)" text-anchor="middle">'+cfg.altoTxt+'</text>';

    // ancho abajo
    s += '<line class="dim" x1="'+x0+'" y1="'+(y1+22)+'" x2="'+x1+'" y2="'+(y1+22)+'" marker-start="url(#ar)" marker-end="url(#ar)"/>';
    s += '<text class="dimtxt" x="'+((x0+x1)/2)+'" y="'+(y1+36)+'" text-anchor="middle">'+cfg.anchoTxt+'</text>';

    // bracket opcional (500 entre centrales)
    if (cfg.bracket) {
      const ya = y0 + cfg.bracket[0]*esc, yb = y0 + cfg.bracket[1]*esc;
      const xb = der ? (ejeX - 22) : (ejeX + 22);
      s += '<line class="dim" x1="'+xb+'" y1="'+ya.toFixed(1)+'" x2="'+xb+'" y2="'+yb.toFixed(1)+'" marker-start="url(#ar)" marker-end="url(#ar)" stroke="'+'#BE1265'+'"/>';
      s += '<text class="holetxt" transform="translate('+(xb-4)+','+((ya+yb)/2)+') rotate(-90)" text-anchor="middle">500</text>';
    }

    // marca del riel medio
    if (cfg.rielMedio != null) {
      const ym = y0 + cfg.rielMedio * esc;
      s += '<line class="center" x1="'+(x0-8)+'" y1="'+ym.toFixed(1)+'" x2="'+(x1+8)+'" y2="'+ym.toFixed(1)+'"/>';
    }

    return '<svg viewBox="0 0 '+W+' '+Hs+'" role="img" aria-label="'+cfg.aria+'">'
      + '<defs><marker id="ar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">'
      + '<path d="M0,1 L10,5 L0,9 z" fill="#1B4FCF"/></marker></defs>' + s + '</svg>';
  }

  function fila(tb, nombre, pos, canto, prof){
    const tr = document.createElement('tr');
    tr.innerHTML = '<td class="l">'+nombre+'</td><td class="key">'+fmt(pos)+'</td><td class="num">'+fmt(canto)+'</td><td class="num">'+prof+'</td>';
    tb.appendChild(tr);
  }

  function tablaHolgura(K, T){
    const cols = [18,19,20,21,22,23,24,25];
    const Tr = Math.min(25, Math.max(18, Math.round(isFinite(T)?T:18)));
    let h = '<table class="clr"><thead><tr><th></th>';
    cols.forEach(function(c){ h += '<th'+(c===Tr?' class="on"':'')+'>T='+c+'</th>'; });
    h += '</tr></thead><tbody>';
    [4,5,6,7,8].forEach(function(k){
      h += '<tr><th'+(k===K?' class="on"':'')+'>K='+k+'</th>';
      cols.forEach(function(c,i){
        const on = (k===K && c===Tr);
        h += '<td'+(on?' class="on"':'')+'>'+CLR[k][i]+'</td>';
      });
      h += '</tr>';
    });
    return h + '</tbody></table>';
  }

  let ultimo = '';
  let lado = 'der';
  let expo = null;

  // ---------- exportación ----------
  function bajar(nombre, texto, mime){
    const blob = new Blob([texto], {type: mime + ';charset=utf-8'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = nombre;
    document.body.appendChild(a); a.click();
    document.body.removeChild(a);
    setTimeout(function(){ URL.revokeObjectURL(url); }, 2000);
  }

  // X con origen en la esquina inferior izquierda de la cara que se taladra
  function ejeXmm(p){ return lado === 'der' ? (p.ancho - p.canto) : p.canto; }

  function dxf(p){
    const o = [];
    const g = (c,v) => { o.push(c); o.push(String(v)); };
    const linea = (x1,y1,x2,y2,capa) => {
      g(0,'LINE'); g(8,capa);
      g(10,x1.toFixed(3)); g(20,y1.toFixed(3)); g(30,'0.0');
      g(11,x2.toFixed(3)); g(21,y2.toFixed(3)); g(31,'0.0');
    };
    const circulo = (cx,cy,r,capa) => {
      g(0,'CIRCLE'); g(8,capa);
      g(10,cx.toFixed(3)); g(20,cy.toFixed(3)); g(30,'0.0'); g(40,r.toFixed(3));
    };

    g(0,'SECTION'); g(2,'HEADER');
    g(9,'$INSUNITS'); g(70,4);              // 4 = milímetros
    g(9,'$EXTMIN'); g(10,'0.0'); g(20,'0.0'); g(30,'0.0');
    g(9,'$EXTMAX'); g(10,p.ancho.toFixed(3)); g(20,p.alto.toFixed(3)); g(30,'0.0');
    g(0,'ENDSEC');

    g(0,'SECTION'); g(2,'ENTITIES');
    linea(0,0,p.ancho,0,'CONTORNO');
    linea(p.ancho,0,p.ancho,p.alto,'CONTORNO');
    linea(p.ancho,p.alto,0,p.alto,'CONTORNO');
    linea(0,p.alto,0,0,'CONTORNO');

    const x = ejeXmm(p);
    p.holes.forEach(function(h){
      circulo(x, p.alto - h.pos, 17.5, p.capa);
    });
    g(0,'ENDSEC'); g(0,'EOF');
    return o.join('\r\n') + '\r\n';
  }

  function csv(){
    const filas = [['Pieza','Barreno','X_mm','Y_mm','Desde_tope_mm','Al_canto_mm','Diametro_mm','Profundidad_mm','Ancho_mm','Alto_mm','Mano']];
    [expo.puerta, expo.lateral].forEach(function(p){
      const x = ejeXmm(p);
      p.holes.forEach(function(h,i){
        filas.push([p.nombre, i+1, fmt(x), fmt(p.alto - h.pos), fmt(h.pos), fmt(p.canto),
                    p.diam, p.prof, fmt(p.ancho), fmt(p.alto), lado === 'der' ? 'Derecha' : 'Izquierda']);
      });
    });
    return filas.map(function(f){ return f.join(','); }).join('\r\n') + '\r\n';
  }

  function json(){
    const pieza = p => ({
      nombre: p.nombre, ancho: p.ancho, alto: p.alto,
      distancia_al_canto: p.canto, diametro: p.diam, profundidad: p.prof,
      origen: 'esquina inferior izquierda, cara a taladrar',
      barrenos: p.holes.map(function(h,i){
        return {n: i+1, x: +fmt(ejeXmm(p)), y: +fmt(p.alto - h.pos), desde_tope: +fmt(h.pos)};
      })
    });
    return JSON.stringify({
      sistema: 'Tutti T926',
      generado: new Date().toISOString().slice(0,10),
      mano: lado === 'der' ? 'derecha' : 'izquierda',
      entradas: expo.entradas,
      derivadas: expo.derivadas,
      piezas: [pieza(expo.puerta), pieza(expo.lateral)]
    }, null, 2);
  }

  function slug(){
    return 'T926_H' + fmt(expo.entradas.H) + '_T' + fmt(expo.entradas.T) + '_' + (lado === 'der' ? 'der' : 'izq');
  }

  function calcular(){
    const d = leer();
    const DH = d.H - 18;
    const DW = modoDoble ? (d.W/2 + 50) : d.DWm;
    const S3 = d.T + 20;
    const S1 = d.S - 5, S2 = d.S + d.T + 2, S4 = d.S - 20;
    const H1 = d.H / 2, H2 = d.H - 200;
    const W1 = d.W + 106 + 2*d.C;
    const DS = S2 - 100;

    avisar(d, DH);

    const puerta = [
      {n:'1 · superior', pos:200},
      {n:'2 · centro alto', pos:DH/2 - 250},
      {n:'3 · centro bajo', pos:DH/2 + 250},
      {n:'4 · inferior', pos:DH - 200}
    ];
    const lateral = [
      {n:'1 · superior', pos:100},
      {n:'2 · inferior', pos:d.H - 100}
    ];

    // tablas
    const tp = $('tbPuerta'); tp.innerHTML = '';
    puerta.forEach(function(h){ fila(tp, h.n, h.pos, 24.5, '12'); });
    const tl = $('tbLateral'); tl.innerHTML = '';
    lateral.forEach(function(h){ fila(tl, h.n, h.pos, S3, '11.5'); });
    $('dhTxt').textContent = fmt(DH);

    // derivadas
    const params = [
      ['DH','Alto de la puerta','H − 18',DH],
      ['DW','Ancho de la puerta', modoDoble ? 'W/2 + 50' : 'entrada manual', DW],
      ['S3','Barreno al canto del lateral','T + 20',S3],
      ['S1','Ancho del riel medio','S − 5',S1],
      ['S2','Ancho del panel lateral','S + T + 2',S2],
      ['S4','Ancho del aluminio de la guía','S − 20',S4],
      ['H1','Posición del riel medio','H / 2',H1],
      ['H2','Corte del riel vertical','H − 200',H2],
      ['W1','Ancho total con laterales','W + 106 + 2C',W1],
      ['DS','Puerta a ras del lateral','S2 − 100',DS]
    ];
    const tpar = $('tbParam'); tpar.innerHTML = '';
    params.forEach(function(p){
      const tr = document.createElement('tr');
      tr.innerHTML = '<td class="l"><b style="font-family:var(--sans);letter-spacing:.04em">'+p[0]+'</b></td>'
        + '<td class="l" style="font-size:11.5px">'+p[1]+'</td>'
        + '<td style="font-size:11px;color:var(--muted)">'+p[2]+'</td>'
        + '<td class="num">'+fmt(p[3])+'</td>';
      tpar.appendChild(tr);
    });

    // dibujos
    const anchoPuerta = (isFinite(DW) && DW > 0) ? DW : 500;
    const anchoLateral = (isFinite(S2) && S2 > 0) ? S2 : 600;

    $('svgPuerta').innerHTML = dibujar({
      alto: DH, ancho: anchoPuerta, canto: 24.5, lado: lado,
      cantoTxt:'24.5', altoTxt:'DH '+fmt(DH), anchoTxt:'DW '+fmt(DW),
      holes: puerta, bracket:[DH/2-250, DH/2+250], rielMedio: DH/2,
      aria:'Puerta con cuatro barrenos de 35 mm'
    });
    $('svgLateral').innerHTML = dibujar({
      alto: d.H, ancho: anchoLateral, canto: S3, lado: lado,
      cantoTxt:'S3 '+fmt(S3), altoTxt:'H '+fmt(d.H), anchoTxt:'S2 '+fmt(S2),
      holes: lateral, bracket:null, rielMedio: d.H/2,
      aria:'Panel lateral con dos barrenos de 35 mm'
    });

    // datos para exportar
    expo = {
      entradas: {H:d.H, S:d.S, W:d.W, T:d.T, C:d.C, K:d.K},
      derivadas: {DH:DH, DW:DW, S1:S1, S2:S2, S3:S3, S4:S4, H1:H1, H2:H2, W1:W1, DS:DS},
      puerta: {nombre:'Puerta', ancho:anchoPuerta, alto:DH, canto:24.5, diam:35, prof:12,
               capa:'BARRENO_D35_P12', holes:puerta},
      lateral:{nombre:'Panel lateral', ancho:anchoLateral, alto:d.H, canto:S3, diam:35, prof:11.5,
               capa:'BARRENO_D35_P11_5', holes:lateral}
    };

    // holgura
    $('clrTabla').innerHTML = tablaHolgura(d.K, d.T);
    const Tr = Math.min(25, Math.max(18, Math.round(isFinite(d.T)?d.T:18)));
    $('clrTxt').textContent = 'K=' + d.K + ' · T=' + Tr + ' → A = ' + CLR[d.K][Tr-18] + ' mm';

    // escala aproximada
    const escala = Math.round(DH / 460 * 10) / 10;
    $('escala').textContent = isFinite(escala) ? ('aprox. 1:' + escala) : '';

    // texto para copiar
    ultimo =
      'T926 — barrenos\n' +
      'Gabinete: H=' + fmt(d.H) + ' S=' + fmt(d.S) + ' W=' + fmt(d.W) + ' T=' + fmt(d.T) + ' C=' + fmt(d.C) + '\n' +
      'PUERTA (DH=' + fmt(DH) + ', DW=' + fmt(DW) + ') — barreno 35 x 12, a 24.5 del canto\n' +
      puerta.map(function(h,i){ return '  ' + (i+1) + ') ' + fmt(h.pos) + ' desde el tope'; }).join('\n') + '\n' +
      'PANEL LATERAL (alto=' + fmt(d.H) + ', S2=' + fmt(S2) + ') — barreno 35 x 11.5, a ' + fmt(S3) + ' del canto frontal\n' +
      lateral.map(function(h,i){ return '  ' + (i+1) + ') ' + fmt(h.pos) + ' desde el tope'; }).join('\n') + '\n' +
      'Riel medio H1=' + fmt(H1) + ' · riel vertical H2=' + fmt(H2) + ' · riel medio ancho S1=' + fmt(S1);
  }

  // modo de ancho
  $('mDoble').addEventListener('click', function(){
    modoDoble = true;
    $('mDoble').setAttribute('aria-pressed','true');
    $('mManual').setAttribute('aria-pressed','false');
    $('dwManualRow').style.display = 'none';
    calcular();
  });
  $('mManual').addEventListener('click', function(){
    modoDoble = false;
    $('mManual').setAttribute('aria-pressed','true');
    $('mDoble').setAttribute('aria-pressed','false');
    $('dwManualRow').style.display = 'grid';
    calcular();
  });

  $('lDer').addEventListener('click', function(){
    lado = 'der';
    $('lDer').setAttribute('aria-pressed','true');
    $('lIzq').setAttribute('aria-pressed','false');
    calcular();
  });
  $('lIzq').addEventListener('click', function(){
    lado = 'izq';
    $('lIzq').setAttribute('aria-pressed','true');
    $('lDer').setAttribute('aria-pressed','false');
    calcular();
  });

  inputs.forEach(function(el){ el.addEventListener('input', calcular); });

  $('btnDxfP').addEventListener('click', function(){
    bajar(slug() + '_puerta.dxf', dxf(expo.puerta), 'application/dxf');
  });
  $('btnDxfL').addEventListener('click', function(){
    bajar(slug() + '_lateral.dxf', dxf(expo.lateral), 'application/dxf');
  });
  $('btnCsv').addEventListener('click', function(){
    bajar(slug() + '_barrenos.csv', csv(), 'text/csv');
  });
  $('btnJson').addEventListener('click', function(){
    bajar(slug() + '_barrenos.json', json(), 'application/json');
  });

  $('btnCopiar').addEventListener('click', function(){
    const msg = $('copyMsg');
    navigator.clipboard.writeText(ultimo).then(function(){
      msg.textContent = 'Copiado';
      setTimeout(function(){ msg.textContent=''; }, 1800);
    }, function(){
      msg.textContent = 'No se pudo copiar';
    });
  });

  calcular();
})();
</script>
</body>
</html>
